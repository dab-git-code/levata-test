<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
      layout="2columns-left">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">My Quotes</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Levata\ImmutableQuote\Block\Customer\QuoteList"
                   name="levata.immutable.quote.list"
                   template="Levata_ImmutableQuote::customer/quotes.phtml"
                   cacheable="false">
                <block class="Magento\Framework\View\Element\FormKey" name="formkey"/>
            </block>
        </referenceContainer>
    </body>
</page>
