<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote_inmutable" resource="checkout" engine="innodb" comment="Immutable quote metadata (1:1 with quote)">
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="false" identity="false"
                comment="Quote ID"/>
        <column xsi:type="smallint" name="is_locked" unsigned="true" nullable="false" default="1"
                comment="1 = immutable (modifications blocked)"/>
        <column xsi:type="timestamp" name="locked_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="When quote was locked"/>
        <column xsi:type="timestamp" name="unlocked_at" on_update="false" nullable="true"
                comment="When immutability was removed via API"/>
        <column xsi:type="int" name="created_by_admin_id" unsigned="true" nullable="true"
                comment="Admin user who locked the quote"/>
        <column xsi:type="varchar" name="internal_reference" nullable="true" length="255"
                comment="Optional sales reference"/>
        <column xsi:type="text" name="notes" nullable="true" comment="Internal notes"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="quote_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="QUOTE_IMMUTABLE_QUOTE_ID_QUOTE_ENTITY_ID"
                    table="quote_inmutable" column="quote_id"
                    referenceTable="quote" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
        <index referenceId="QUOTE_IMMUTABLE_IS_LOCKED" indexType="btree">
            <column name="is_locked"/>
        </index>
    </table>
    <table name="levata_immutable_quote_api_rate" resource="default" engine="innodb"
           comment="Hourly API rate limit counters">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="consumer_key" nullable="false" length="64"/>
        <column xsi:type="varchar" name="window_key" nullable="false" length="32"
                comment="e.g. 2026-09-22-10"/>
        <column xsi:type="int" name="request_count" unsigned="true" nullable="false" default="0"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="LEVATA_IMMUTABLE_QUOTE_API_RATE_CONSUMER_WINDOW">
            <column name="consumer_key"/>
            <column name="window_key"/>
        </constraint>
    </table>
</schema>
